# The OFF server's gates — every gate dark, so the dark contracts are asserted against a real, differently-enved
# process (ci-diet D4). ci.yml loads this into $GITHUB_ENV before the OFF server boots; gates.on.env overrides it
# for every later step. Same format and the same keys as gates.on.env.
CONNECTOR_ENABLED=false
SIGNUP_ENABLED=false
JOURNEY_PROJECTIONS_ENABLED=false
EXPERIMENT_GOVERNANCE_ENABLED=false
EXPERIMENT_BUILDER_ENABLED=false
REPORT_SHARES_ENABLED=false
SIGNALS_ENABLED=false
# account-from-the-terminal S3.1: production has connector writes ON (verified from /install's gate-aware copy,
# 2026-10-06); a URL made by a person writes only behind it, so CI asserts it lit here and dark on the OFF server.
CONNECTOR_WRITES_ENABLED=false
FLAG_SERVING_ENABLED=false
FLAG_CONSOLE_ENABLED=false
FLAG_RULE_BUILDER_ENABLED=false
RESILIENCE_SCENARIOS_ENABLED=false
SECURITY_SIMULATIONS_ENABLED=false
AUTOMATIC_CIRCUIT_BREAKERS_ENABLED=false
SCENARIO_AUTHORING_ENABLED=false
FLAG_DEFINITION_SYNC_ENABLED=false
