# The ON server's gates — the state CI asserts against, which is production's (ci-diet D4).
# ci.yml loads this into $GITHUB_ENV before the ON server boots, so the server and every test process after it read
# the same values by construction. scripts/run-local-e2e.mjs reads it too. Read by scripts/lib/gate-env.mjs:
# one KEY=true|false per line; anything else fails the load. Add a gate here AND in gates.off.env.
CONNECTOR_ENABLED=true
# SIGNUP gates tenant provisioning too: auth.setup.ts signs in and waits for it, so the authed project needs it ON.
SIGNUP_ENABLED=true
JOURNEY_PROJECTIONS_ENABLED=true
EXPERIMENT_GOVERNANCE_ENABLED=true
EXPERIMENT_BUILDER_ENABLED=true
REPORT_SHARES_ENABLED=true
SIGNALS_ENABLED=true
# account-from-the-terminal S3.1: production has connector writes ON (verified from /install's gate-aware copy,
# 2026-10-06); a URL made by a person writes only behind it, so CI asserts it lit here and dark on the OFF server.
CONNECTOR_WRITES_ENABLED=true
FLAG_CONSOLE_ENABLED=true
FLAG_RULE_BUILDER_ENABLED=true
RESILIENCE_SCENARIOS_ENABLED=true
SECURITY_SIMULATIONS_ENABLED=true
AUTOMATIC_CIRCUIT_BREAKERS_ENABLED=true
# OFF even here: both enable owner mutation surfaces, a decision CI has not made. With them off,
# scenario-authoring-dark.authed RUNS and scenario-authoring.authed skips (the local runner turns both on).
SCENARIO_AUTHORING_ENABLED=false
FLAG_DEFINITION_SYNC_ENABLED=false
