    "usage": "frijoles <command> [flags]",
    "commands": [
      {
        "command": "login",
        "summary": "sign this machine in (browser), or save a CLI token",
        "usage": "frijoles login [--token <token>] [--api <url>]",
        "needsAuth": false,
        "flags": [
          {
            "flag": "--token",
            "takesValue": true,
            "describe": "the token, instead of reading stdin"
          },
          {
            "flag": "--api",
            "takesValue": true,
            "describe": "the deployment (default: https://goldenfrijoles.com)"
          }
        ]
      },
      {
        "command": "logout",
        "summary": "forget the saved token on this machine",
        "usage": "frijoles logout",
        "needsAuth": false,
        "flags": []
      },
      {
        "command": "whoami",
