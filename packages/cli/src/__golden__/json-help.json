        "usage": "frijoles experiments create --flag <key> --metric <event> [--guardrail <event>]… [--entity visitor] [--ends open|YYYY-MM-DD | --weeks <1-8>] [--split <pct>] [--decrease] [--name <version>]… [--from <answers.json>] [--project <slug>] [--json]",
        "needsAuth": true,
        "flags": [
          {
            "flag": "--flag",
            "takesValue": true,
            "describe": "the feature the test changes (an existing flag)"
          },
          {
            "flag": "--metric",
            "takesValue": true,
            "describe": "the one number that decides it"
          },
          {
            "flag": "--guardrail",
            "takesValue": true,
            "describe": "a number that must not get worse (repeatable)"
          },
          {
            "flag": "--entity",
            "takesValue": true,
            "describe": "who is counted (default: visitor)"
          },
          {
            "flag": "--ends",
            "takesValue": true,
            "describe": "run through this day (from tomorrow), or open — until you stop it (default)"
          },
          {
            "flag": "--weeks",
            "takesValue": true,
            "describe": "run for this many weeks instead"
          },
          {
            "flag": "--split",
            "takesValue": true,
            "describe": "the new version's share, 1–99 (default 50)"
          },
          {
            "flag": "--decrease",
            "takesValue": false,
            "describe": "the metric should go DOWN"
          },
          {
            "flag": "--name",
            "takesValue": true,
            "describe": "version names, control first (repeatable)"
          },
          {
            "flag": "--from",
            "takesValue": true,
            "describe": "the builder's answers as JSON, instead of the flags above"
          },
          {
            "flag": "--project",
            "takesValue": true,
            "describe": "the project (default: the remembered one)"
          }
        ]
      },
      {
        "command": "experiments start",
        "summary": "start an experiment: the split serves and everyone in it is counted",
        "usage": "frijoles experiments start <key> [--project <slug>] [--json]",
        "needsAuth": true,
        "flags": [
          {
            "flag": "--project",
            "takesValue": true,
            "describe": "the project (default: the remembered one)"
          }
        ]
      },
      {
        "command": "experiments pause",
        "summary": "pause an experiment: its split comes off; resume puts it back",
        "usage": "frijoles experiments pause <key> [--project <slug>] [--json]",
        "needsAuth": true,
        "flags": [
          {
            "flag": "--project",
            "takesValue": true,
            "describe": "the project (default: the remembered one)"
          }
        ]
      },
      {
        "command": "experiments resume",
        "summary": "resume a paused experiment: its split serves again",
        "usage": "frijoles experiments resume <key> [--project <slug>] [--json]",
        "needsAuth": true,
        "flags": [
          {
            "flag": "--project",
            "takesValue": true,
            "describe": "the project (default: the remembered one)"
          }
        ]
      },
      {
        "command": "experiments stop",
        "summary": "stop an experiment: nobody new is counted",
        "usage": "frijoles experiments stop <key> [--project <slug>] [--json]",
        "needsAuth": true,
        "flags": [
          {
            "flag": "--project",
            "takesValue": true,
            "describe": "the project (default: the remembered one)"
          }
        ]
      },
      {
        "command": "experiments decide",
        "summary": "record the call — ship a version, keep the current one, or not — at any time",
        "usage": "frijoles experiments decide <key> (--ship [--variant <key>] | --keep | --inconclusive | --iterate | --invalid) --reason \"<why>\" [--rollout] [--project <slug>] [--json]",
        "needsAuth": true,
        "flags": [
          {
            "flag": "--ship",
            "takesValue": false,
            "describe": "ship a version: the one leading, or --variant"
          },
          {
            "flag": "--variant",
            "takesValue": true,
            "describe": "with --ship: the version to ship (its flag variant key)"
          },
          {
            "flag": "--keep",
            "takesValue": false,
            "describe": "keep the current version"
          },
          {
            "flag": "--inconclusive",
            "takesValue": false,
            "describe": "no clear answer"
          },
          {
            "flag": "--iterate",
            "takesValue": false,
            "describe": "change it and run again"
          },
          {
            "flag": "--invalid",
            "takesValue": false,
            "describe": "the numbers cannot be trusted"
          },
          {
            "flag": "--reason",
            "takesValue": true,
            "describe": "why — kept in the decision record (required)"
          },
          {
            "flag": "--rollout",
            "takesValue": false,
            "describe": "serve the shipped version to everyone in production"
          },
          {
            "flag": "--project",
            "takesValue": true,
            "describe": "the project (default: the remembered one)"
          }
        ]
      },
      {
        "command": "experiments delete",
        "summary": "delete an experiment: its split comes off and it leaves the list (its record is kept)",
        "usage": "frijoles experiments delete <key> [--project <slug>] [--json]",
        "needsAuth": true,
        "flags": [
          {
            "flag": "--project",
            "takesValue": true,
            "describe": "the project (default: the remembered one)"
          }
        ]
      },
      {
        "command": "experiments decision",
        "summary": "an experiment's decision record (the latest version unless --version)",
        "usage": "frijoles experiments decision <key> [--version <n>] [--project <slug>] [--json]",
        "needsAuth": true,
        "flags": [
          {
            "flag": "--version",
            "takesValue": true,
            "describe": "the definition version (default: the latest)"
          },
          {
            "flag": "--project",
            "takesValue": true,
            "describe": "the project (default: the remembered one)"
          }
        ]
      },
      {
        "command": "keys ls",
        "summary": "every credential that can reach this project",
        "usage": "frijoles keys ls [--project <slug>] [--json]",
        "needsAuth": true,
        "flags": [
          {
            "flag": "--project",
            "takesValue": true,
            "describe": "the project (default: the remembered one)"
          }
        ]
      },
      {
        "command": "keys create",
        "summary": "mint a credential — the kind is required, never guessed",
        "usage": "frijoles keys create --type flag_read --env production --label \"my app\"",
        "needsAuth": true,
        "flags": [
          {
            "flag": "--project",
            "takesValue": true,
            "describe": "the project (default: the remembered one)"
          },
          {
            "flag": "--type",
            "takesValue": true,
            "describe": "ingest | flag_read | flag_sync — required"
          },
          {
            "flag": "--label",
            "takesValue": true,
            "describe": "what holds it — required"
          },
          {
            "flag": "--env",
            "takesValue": true,
            "describe": "required for flag_read"
          },
          {
            "flag": "--source",
            "takesValue": true,
            "describe": "required for flag_sync"
          }
        ]
      },
      {
        "command": "keys revoke",
        "summary": "kill a credential, immediately and permanently",
        "usage": "frijoles keys revoke <id> --type ingest",
        "needsAuth": true,
        "flags": [
          {
            "flag": "--project",
            "takesValue": true,
            "describe": "the project (default: the remembered one)"
          },
          {
            "flag": "--type",
            "takesValue": true,
            "describe": "ingest | flag_read | flag_sync — required"
          }
        ]
      }
    ],
    "globalFlags": [
      "--json",
      "--project",
      "--api",
      "--token",
      "--help",
      "--version"
    ],
    "environment": [
      "GOLDEN_FRIJOLES_TOKEN",
      "GOLDEN_FRIJOLES_URL",
      "GOLDEN_FRIJOLES_PROJECT"
    ],
    "exitCodes": [
      {
        "code": 0,
        "name": "ok",
        "means": "it worked"
      },
      {
        "code": 1,
        "name": "usage",
        "means": "the command is wrong — nothing was sent"
      },
      {
        "code": 2,
        "name": "auth",
        "means": "the credential is not accepted — run `frijoles login`"
      },
      {
        "code": 3,
        "name": "not-found",
        "means": "no such thing, or not yours"
      },
      {
        "code": 4,
        "name": "conflict",
        "means": "someone else changed it — re-read and retry"
      },
      {
        "code": 5,
        "name": "partial",
        "means": "some environments changed and some did not"
      },
      {
        "code": 6,
        "name": "server",
        "means": "the server or the network is unwell — retry"
      }
    ]
  }
}
