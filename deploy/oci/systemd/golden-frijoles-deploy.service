# off-vercel-hosting S2 — the pull side of "merging to main is the deploy" (D9). Quiet unless the :main digest, the
# pin or the site file moved. Installed once by deploy/oci/README.md → First install.
[Unit]
Description=golden-frijoles: deploy a new :main image if one was pushed
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/opt/golden-frijoles/deploy/oci/update.sh --if-changed
TimeoutStartSec=15min
